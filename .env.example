# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=smart_todo
POSTGRES_PASSWORD=smart_todo
POSTGRES_DB=smart_todo
DATABASE_URL=postgresql+psycopg://smart_todo:smart_todo@localhost:5432/smart_todo
# dev | production. Production turns off /docs, forces secure cookies, HSTS and the dev push page off.
# (ENV=production works too.)
APP_ENV=dev
DISPLAY_TIMEZONE=Asia/Kolkata
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback
# Fernet key(s); comma-separated for rotation, newest first.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
# Signs session cookies. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Signs the Mark-as-done links in emails. Empty = use SESSION_SECRET. Comma-separated for rotation.
MARK_DONE_SECRET=
# Set true when served over HTTPS
COOKIE_SECURE=false
# Run the background scheduler (reminders, polling sync, digest) inside the API process.
SCHEDULER_ENABLED=false
# Optional SMS reminders (needs a provider plug-in; India needs DLT registration).
SMS_ENABLED=false

# ---- Module 9: notification channels ----
# Public address of this API, used in the "Mark as done" link inside emails.
PUBLIC_BASE_URL=http://localhost:8000
# Email (SMTP). See the options in the Module 9 notes. Leave SMTP_HOST empty to disable email.
SMTP_HOST=
SMTP_PORT=587
# starttls (port 587) or ssl (port 465)
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=Smart To-Do <sender@example.com>
# Web Push. Generate with: backend\.venv\Scripts\python.exe backend\scripts\generate_vapid_keys.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact for the push services, e.g. mailto:you@example.com
VAPID_SUBJECT=

# ---- Module 11: dashboard ----
# Where the backend sends you after Google sign-in, and where a test push opens.
POST_LOGIN_REDIRECT=http://localhost:3000/
FRONTEND_URL=http://localhost:3000
